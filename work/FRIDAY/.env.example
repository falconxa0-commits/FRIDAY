# =============================================================================
# FRIDAY AI Assistant — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your actual values.
# All variables are optional unless marked (required).
# =============================================================================

# --- BRAIN PROVIDERS ---------------------------------------------------------
# Which LLM to use: "glm" (default, free), "claude", "gemini", or "ollama"
BRAIN_PROVIDER=glm

# Z.ai / ZhipuAI GLM (default, free-tier provider)
# Get your API key at https://open.bigmodel.cn/
# The free tier (glm-4-flash) requires no payment method.
GLM_API_KEY=your_glm_api_key_here

# GLM model override (default: glm-4-flash)
# Options: glm-4-flash (free), glm-4, glm-4-plus, glm-4v, glm-4-long
GLM_MODEL=glm-4-flash

# Anthropic Claude (required if BRAIN_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model override (default: claude-sonnet-4-20250514)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Google Gemini (required if BRAIN_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model override (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (reserved for future use)
OPENAI_API_KEY=your_openai_api_key_here

# --- LOCAL BRAIN (Ollama) ----------------------------------------------------
# Model name for local inference (default: llama3)
OLLAMA_MODEL=llama3

# Ollama base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# --- DATABASE & MEMORY -------------------------------------------------------
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# --- WEB SEARCH --------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here

# --- VOICE & VISION ----------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here

# --- INTEGRATIONS ------------------------------------------------------------
OPENWEATHERMAP_API_KEY=your_weather_key
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
HOME_ASSISTANT_TOKEN=your_ha_token

# --- SKILLS CONFIGURATION ----------------------------------------------------
# Default location for the Morning Briefing skill
FRIDAY_DEFAULT_LOCATION=Lagos

# --- SECURITY ----------------------------------------------------------------
# API token for authenticating with the FRIDAY API.  Leave empty for
# dev mode (no auth required).  Generate a secure token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FRIDAY_API_TOKEN=your_generated_secure_token_here
# Set FRIDAY_DEV_MODE=1 ONLY for local development without auth (NEVER in production)
# If FRIDAY_API_TOKEN is empty and FRIDAY_DEV_MODE is not 1, a random token
# is auto-generated on first start and saved here.
# FRIDAY_DEV_MODE=0

# Autonomy profile: GUEST (everything requires approval),
# STANDARD (read-only auto-approves), POWER (PC/Browser auto-approves)
AUTONOMY_PROFILE=GUEST

# --- IDENTITY ----------------------------------------------------------------
# Which identity mode to use: General, Strategist, Creative, Debugger, Guardian
FRIDAY_IDENTITY=General

# --- LOGGING -----------------------------------------------------------------
LOG_LEVEL=INFO

# --- CONVERSATION HISTORY ----------------------------------------------------
# Maximum number of messages to keep in conversation history (default: 50)
HISTORY_LIMIT=50

# --- ALLOWED ORIGINS (CORS) --------------------------------------------------
# Comma-separated list of allowed origins for the API server
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8000
