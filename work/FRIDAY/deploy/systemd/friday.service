[Unit]
Description=Friday AI Assistant
After=network.target

[Service]
Type=simple
User=friday
Group=friday
WorkingDirectory=/opt/friday
EnvironmentFile=/opt/friday/.env
ExecStart=/opt/friday/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/friday/data

[Install]
WantedBy=multi-user.target
